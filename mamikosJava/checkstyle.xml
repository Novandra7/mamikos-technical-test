<?xml version="1.0"?>
<!DOCTYPE module PUBLIC
    "-//Checkstyle//DTD Checkstyle Configuration 1.3//EN"
    "https://checkstyle.org/dtds/configuration_1_3.dtd">

<!--
  Trimmed rule set focused on defects and readability rather than on
  formatting: Spotless (palantir-java-format) already owns formatting, so
  duplicating whitespace/indentation rules here would only create conflicts.
-->
<module name="Checker">
  <property name="severity" value="warning"/>
  <property name="fileExtensions" value="java"/>

  <module name="FileTabCharacter">
    <property name="eachLine" value="true"/>
  </module>
  <module name="NewlineAtEndOfFile"/>

  <!-- Lets @SuppressWarnings("checkstyle:RuleName") on a class/method actually suppress
       that rule for it — without this top-level filter plus the TreeWalker holder below,
       the annotation is silently a no-op and every such annotation in the codebase would be
       lying about what it does. -->
  <module name="SuppressWarningsFilter"/>

  <module name="TreeWalker">
    <module name="SuppressWarningsHolder"/>

    <!-- Imports -->
    <module name="UnusedImports"/>
    <module name="RedundantImport"/>
    <module name="AvoidStarImport">
      <property name="allowStaticMemberImports" value="true"/>
    </module>
    <module name="IllegalImport">
      <property name="illegalPkgs" value="sun, com.sun, org.apache.commons.lang"/>
    </module>

    <!-- Naming -->
    <module name="PackageName"/>
    <module name="TypeName"/>
    <module name="MethodName"/>
    <module name="LocalVariableName"/>
    <module name="ParameterName"/>
    <module name="ConstantName">
      <!-- The conventional lowercase "log" for an SLF4J Logger constant is deliberately
           allowed alongside real UPPER_SNAKE_CASE constants. -->
      <property name="format" value="^log$|^[A-Z][A-Z0-9]*(_[A-Z0-9]+)*$"/>
    </module>
    <module name="MemberName"/>

    <!-- Defect-prone constructs -->
    <module name="EqualsHashCode"/>
    <module name="SimplifyBooleanExpression"/>
    <module name="SimplifyBooleanReturn"/>
    <module name="StringLiteralEquality"/>
    <module name="MissingSwitchDefault"/>
    <module name="FallThrough"/>
    <module name="DefaultComesLast"/>
    <module name="EmptyStatement"/>
    <module name="IllegalThrows"/>
    <module name="NoFinalizer"/>
    <module name="OneStatementPerLine"/>
    <module name="MultipleVariableDeclarations"/>
    <module name="UpperEll"/>
    <module name="ArrayTypeStyle"/>
    <module name="ModifierOrder"/>
    <module name="NeedBraces"/>
    <module name="CovariantEquals"/>
    <module name="EqualsAvoidNull"/>

    <!-- Complexity guard rails -->
    <module name="MethodLength">
      <property name="max" value="80"/>
    </module>
    <module name="ParameterNumber">
      <property name="max" value="10"/>
    </module>

    <!-- Debug leftovers must never reach the repository -->
    <module name="Regexp">
      <property name="format" value="System\.(out|err)\.print"/>
      <property name="illegalPattern" value="true"/>
      <property name="message" value="Use a logger instead of System.out/System.err"/>
    </module>
    <module name="Regexp">
      <property name="format" value="printStackTrace\(\)"/>
      <property name="illegalPattern" value="true"/>
      <property name="message" value="Use a logger instead of printStackTrace()"/>
    </module>
  </module>
</module>
