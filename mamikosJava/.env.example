# Copy to .env and fill in real values before running docker compose or the jar directly.
SPRING_PROFILES_ACTIVE=dev

DB_URL=jdbc:postgresql://localhost:5432/mamikos_kost
DB_USERNAME=mamikos
DB_PASSWORD=secret

REDIS_HOST=localhost
REDIS_PORT=6379

# Must be a base64 string of at least 256 bits. Generate one with:
#   openssl rand -base64 48
JWT_SECRET=

CREDIT_QUOTA_REGULAR=20
CREDIT_QUOTA_PREMIUM=40
CREDIT_INQUIRY_COST=5
CREDIT_RECHARGE_STRATEGY=RESET
CREDIT_RECHARGE_CRON=0 0 0 1 * *

CORS_ALLOWED_ORIGINS=http://localhost:3000
